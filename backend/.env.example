# انسخ هذا الملف إلى .env واملأ القيم الحقيقية. لا ترفع .env أبداً إلى Git.

# المفتاح السري لجانغو (مطلوب إجباراً عند DEBUG=False)
SECRET_KEY=

# وضع التطوير: True محلياً، False في الإنتاج
DEBUG=True

# نطاقات مسموح بها في الإنتاج فقط (مفصولة بفواصل)، مثل: example.com,api.example.com
ALLOWED_HOSTS=

# قاعدة البيانات المحلية (MySQL) - تُستخدم فقط إذا لم يكن DATABASE_URL مضبوطاً
DB_NAME=ai_talker_db
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# رابط قاعدة بيانات كامل (يُستخدم في الإنتاج، يطغى على إعدادات DB_* أعلاه)
# مثال PostgreSQL على Neon: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# Cloudinary لتخزين الملفات (الصوتيات والوسائط المرفوعة)
CLOUDINARY_URL=

# Google Identity Services لتسجيل الدخول بحساب Google
# نفس القيمة يجب وضعها في GOOGLE_CLIENT_ID داخل frontend/js/main.js
GOOGLE_CLIENT_ID=

# إرسال البريد (نموذج تواصل معنا) عبر Gmail SMTP - App Password وليس كلمة مرور الحساب
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
CONTACT_EMAIL=
