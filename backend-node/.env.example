# انسخ هذا الملف إلى .env واملأ القيم الحقيقية. لا ترفع .env أبداً إلى Git.

# المنفذ الذي يستمع عليه الخادم (Hostinger يضبطه تلقائياً عادة عبر PORT)
PORT=8000

# مفتاح سرّي لتوقيع توكنات JWT (اختر سلسلة عشوائية طويلة)
SECRET_KEY=

# قاعدة بيانات MySQL
DB_NAME=ai_talker_node
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# النطاقات المسموح بها لطلبات CORS (مفصولة بفواصل)
CORS_ALLOWED_ORIGINS=https://talker.lughaty.cloud

# Cloudinary لتخزين الملفات غير المدعومة للمعالجة المباشرة
CLOUDINARY_URL=

# Google Identity Services لتسجيل الدخول بحساب Google
# نفس القيمة يجب وضعها في GOOGLE_CLIENT_ID داخل frontend/js/main.js
GOOGLE_CLIENT_ID=

# إرسال البريد (نموذج تواصل معنا) عبر Gmail SMTP - App Password وليس كلمة مرور الحساب
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
CONTACT_EMAIL=

# مفتاح Google Cloud API (مدفوع): يُستخدم لـ Translation API و Cloud Vision API
# (استخراج نص الصور)، يجب تفعيل الخدمتين على نفس مشروع Google Cloud.
GOOGLE_TRANSLATE_API_KEY=

# مفتاح OpenAI (مدفوع): طبقة ترجمة احتياطية + تحويل الصوت إلى نص عبر Whisper.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# بريد اختياري يُرفق بطلبات MyMemory (يضاعف الحصة المجانية اليومية)
MYMEMORY_CONTACT_EMAIL=

# بيانات إنشاء مستخدم الأدمن الوحيد (استخدمها مرة واحدة مع: npm run seed:admin)
ADMIN_USERNAME=admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
